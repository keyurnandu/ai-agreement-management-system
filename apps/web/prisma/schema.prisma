// Prisma schema — owned by apps/web (the system-of-record).
//
// Local dev uses SQLite. SQLite in Prisma does NOT support enums or scalar
// lists, so "enum-like" columns are modelled as String with the allowed
// values documented inline (and enforced in TypeScript via zod unions).
//
// To move to the cloud: change provider to "postgresql" and point
// DATABASE_URL at Postgres. The model definitions are unchanged.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" // cloud: "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String? // null when authenticated via OIDC/SSO
  role         String   @default("VIEWER") // ADMIN | MANAGER | EDITOR | SIGNER | VIEWER
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  documents   Document[]   @relation("UploadedBy")
  permissions Permission[]
  recipients  Recipient[]
  auditEvents AuditEvent[] @relation("ActorEvents")
  annotations Annotation[] @relation("AnnotationAuthor")
}

model Document {
  id          String   @id @default(cuid())
  title       String
  description String?
  kind        String   @default("FILE") // FILE | COLLECTION
  commercialId     String?  @unique // DCOL-n for collections
  commercialTypeId String?
  commercialType   CommercialRecordType? @relation(fields: [commercialTypeId], references: [id])
  collectionParentId String?
  collectionParent   Document?  @relation("DocCollection", fields: [collectionParentId], references: [id], onDelete: SetNull)
  collectionChildren Document[] @relation("DocCollection")
  status      String   @default("ACTIVE") // ACTIVE | ARCHIVED
  ownerId     String
  owner       User     @relation("UploadedBy", fields: [ownerId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  versions    DocumentVersion[]
  agreement   Agreement?
  permissions Permission[]
  annotations Annotation[]

  @@index([ownerId])
  @@index([collectionParentId])
}

model DocumentVersion {
  id               String   @id @default(cuid())
  documentId       String
  document         Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version          Int
  storageKey       String // opaque key in the StorageProvider
  contentType      String   @default("application/pdf")
  byteSize         Int      @default(0)
  pageCount        Int      @default(0)
  originalFilename String?
  checksum         String?
  note             String? // what changed in this version (e.g. "rotated page 2")
  createdById      String?
  createdAt        DateTime @default(now())

  @@unique([documentId, version])
}

model Agreement {
  id          String    @id @default(cuid())
  title       String
  status      String    @default("DRAFT") // DRAFT | SENT | IN_PROGRESS | COMPLETED | DECLINED | VOIDED | EXPIRED
  documentId  String    @unique
  document    Document  @relation(fields: [documentId], references: [id])
  ownerId     String
  routingType String    @default("SEQUENTIAL") // SEQUENTIAL | PARALLEL
  message     String?
  expiresAt   DateTime?
  sentAt      DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  recipients  Recipient[]
  fields      Field[]
  permissions Permission[]
}

model Recipient {
  id           String    @id @default(cuid())
  agreementId  String
  agreement    Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?     @relation(fields: [userId], references: [id])
  email        String
  name         String?
  role         String    @default("SIGNER") // SIGNER | APPROVER | CC
  routingOrder Int       @default(1)
  status       String    @default("PENDING") // PENDING | SENT | VIEWED | SIGNED | DECLINED
  accessToken  String?   @unique // tokenized signing-link secret
  signedAt     DateTime?
  createdAt    DateTime  @default(now())

  fields Field[]

  @@index([agreementId])
}

model Field {
  id          String     @id @default(cuid())
  agreementId String
  agreement   Agreement  @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  recipientId String?
  recipient   Recipient? @relation(fields: [recipientId], references: [id])
  type        String // SIGNATURE | INITIAL | DATE | TEXT | CHECKBOX
  label       String? // e.g. "Name", "Title" — shown to signers
  page        Int        @default(1)
  x           Float
  y           Float
  width       Float
  height      Float
  value       String?
  required    Boolean    @default(true)
  createdAt   DateTime   @default(now())

  @@index([agreementId])
}

model Permission {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  resourceType String // DOCUMENT | AGREEMENT
  documentId   String?
  document     Document?  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  agreementId  String?
  agreement    Agreement? @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  level        String // VIEW | COMMENT | EDIT | MANAGE
  createdAt    DateTime   @default(now())

  @@index([userId])
}

model AuditEvent {
  id           String   @id @default(cuid())
  actorId      String?
  actor        User?    @relation("ActorEvents", fields: [actorId], references: [id])
  actorEmail   String?
  action       String // e.g. "document.upload", "agreement.send", "auth.login"
  resourceType String?
  resourceId   String?
  ip           String?
  userAgent    String?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([resourceType, resourceId])
  @@index([createdAt])
}

model Annotation {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionId  String? // version the coordinates were authored against
  page       Int      @default(1)
  type       String // HIGHLIGHT | COMMENT | NOTE | STRIKEOUT | DRAWING
  rect       Json? // {x,y,w,h} in PDF points (or list of quads)
  color      String   @default("#ffd54f")
  text       String?
  authorId   String
  author     User     @relation("AnnotationAuthor", fields: [authorId], references: [id])
  resolved   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([documentId, page])
}

// ── Structured authoring (contracts-as-data) ──────────────────────────────────

model ClauseLibraryEntry {
  id        String   @id @default(cuid())
  key       String   @unique
  title     String
  category  String?
  body      String // approved standard clause text
  fallbacks Json? // [{ label, text, riskLevel }] pre-approved alternatives
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  templateClauses TemplateClause[]
}

model Template {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  variables   Json? // [{ key, label, type, required }]
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clauses   TemplateClause[]
  contracts Contract[]
}

model TemplateClause {
  id         String             @id @default(cuid())
  templateId String
  template   Template           @relation(fields: [templateId], references: [id], onDelete: Cascade)
  clauseId   String
  clause     ClauseLibraryEntry @relation(fields: [clauseId], references: [id])
  order      Int                @default(1)
  required   Boolean            @default(true)

  @@index([templateId])
}

model Contract {
  id               String    @id @default(cuid())
  commercialId     String?   @unique
  commercialTypeId String?
  commercialType   CommercialRecordType? @relation(fields: [commercialTypeId], references: [id])
  parentContractId String?
  parentContract   Contract? @relation("ContractHierarchy", fields: [parentContractId], references: [id], onDelete: SetNull)
  childContracts   Contract[] @relation("ContractHierarchy")
  title            String
  status      String    @default("DRAFT") // DRAFT | GENERATED | SENT
  templateId  String?
  template    Template? @relation(fields: [templateId], references: [id])
  variables   Json?
  lineItems   Json? // sales: [{ productId?, sku, name, description, quantity, unitPrice, currency }] picked from master data
  documentId  String? // rendered Document.id (no FK; Document model untouched)
  dealId      String?   @unique // linked deal workflow record (same commercialId)
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  clauses ContractClause[]

  @@index([parentContractId])
  @@index([commercialTypeId])
}

model ContractClause {
  id             String   @id @default(cuid())
  contractId     String
  contract       Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  order          Int      @default(1)
  title          String
  body           String
  sourceClauseId String?
  isDeviation    Boolean  @default(false)

  @@index([contractId])
}

// ── Custom attributes & extraction (schema groundwork; execution in Phase 3) ──

model AttributeDefinition {
  id                String   @id @default(cuid())
  key               String   @unique
  label             String
  group             String? // attribute group (folder) for the admin list
  type              String   @default("TEXT") // TEXT | DATE | NUMBER | BOOLEAN | ENUM
  documentType      String? // restrict extraction to a document type
  mode              String   @default("STRICT") // STRICT (verbatim) | FLEXIBLE (infer)
  prompt            String // natural-language extraction instruction
  options           Json? // choices for ENUM
  inclusionExamples Json? // string[] of positive examples
  exclusionExamples Json? // string[] of negative examples
  scope             String   @default("BOTH") // DOCUMENT | CONTRACT | BOTH
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  values AttributeValue[]
}

model AttributeValue {
  id           String              @id @default(cuid())
  definitionId String
  definition   AttributeDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  documentId   String? // references Document.id (no FK)
  contractId   String? // references Contract.id (no FK)
  value        String?
  confidence   Float?
  source       String? // page / snippet the value came from
  method       String              @default("AI") // AI | MANUAL
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([documentId])
  @@index([contractId])
}

// ── External API layer (Phase 6) ──────────────────────────────────────────────

model ApiKey {
  id          String    @id @default(cuid())
  name        String
  prefix      String    @unique // public lookup id (also the displayed key prefix)
  keyHash     String // sha256 of the full secret
  scopes      Json? // string[] e.g. ["documents:read","agreements:read"]
  active      Boolean   @default(true)
  createdById String?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
}

model WebhookSubscription {
  id             String    @id @default(cuid())
  url            String
  events         Json? // string[] of event names, or ["*"]
  secret         String // HMAC signing secret
  active         Boolean   @default(true)
  createdById    String?
  lastStatus     Int?
  lastDeliveryAt DateTime?
  createdAt      DateTime  @default(now())
}

// ── Procurement workflow (org ↔ vendor negotiation) ───────────────────────────

model OrganizationSettings {
  id            String   @id @default("default")
  orgName       String   @default("Your Organization")
  logoStorageKey String?
  headerText    String?
  footerText    String?
  updatedAt     DateTime @updatedAt
}

model FileTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  documentId  String // master PDF/DOCX-as-PDF shell
  direction   String   @default("ORG_SELLING") // ORG_SELLING | ORG_BUYING
  active      Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deals Deal[]
}

model ComplianceRulePack {
  id          String   @id @default(cuid())
  name        String
  direction   String   @default("ORG_BUYING") // ORG_SELLING | ORG_BUYING — Adobe T&C per side
  documentId  String? // uploaded rules PDF (optional)
  rulesText   String // extracted / pasted rules
  active      Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deals Deal[]
}

model CommercialIdSequence {
  prefix  String @id // SMCW | PMCW | SOR | POR | custom
  nextVal Int    @default(1)
}

model CommercialRecordType {
  id          String   @id @default(cuid())
  key         String   @unique // smcw, sor, custom_amendment
  name        String
  prefix      String   @unique // SMCW, SOR — used in commercialId
  direction   String   // ORG_SELLING | ORG_BUYING
  domain      String   @default("DEAL") // DEAL | CONTRACT | DOCUMENT
  isRoot      Boolean  @default(false)
  description String?
  system      Boolean  @default(false)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deals       Deal[]
  contracts   Contract[]
  documents   Document[]
  childLinks  CommercialTypeLink[] @relation("ChildType")
  parentLinks CommercialTypeLink[] @relation("ParentType")
}

model CommercialTypeLink {
  id           String               @id @default(cuid())
  parentTypeId String
  parentType   CommercialRecordType @relation("ParentType", fields: [parentTypeId], references: [id], onDelete: Cascade)
  childTypeId  String
  childType    CommercialRecordType @relation("ChildType", fields: [childTypeId], references: [id], onDelete: Cascade)

  @@unique([parentTypeId, childTypeId])
}

model Deal {
  id               String    @id @default(cuid())
  commercialId     String?   @unique // e.g. SMCW-1, SOR-2, PMCW-3, POR-4
  commercialTypeId String?
  commercialType   CommercialRecordType? @relation(fields: [commercialTypeId], references: [id])
  recordType       String    @default("ORDER_FORM") // legacy; prefer commercialTypeId
  parentDealId     String?
  parentDeal       Deal?     @relation("DealHierarchy", fields: [parentDealId], references: [id], onDelete: SetNull)
  childDeals       Deal[]    @relation("DealHierarchy")
  title            String
  direction        String    @default("ORG_SELLING") // ORG_SELLING | ORG_BUYING
  status           String    @default("DRAFT")
  // DRAFT | WITH_VENDOR | VENDOR_SUBMITTED | UNDER_REVIEW | ISSUES_OPEN | APPROVED | SIGNING | COMPLETED
  documentId       String
  contractId       String?   @unique // linked structured contract (same commercialId)
  agreementId      String?
  ownerId          String
  vendorEmail      String
  vendorName       String?
  vendorAccessToken String   @unique
  fileTemplateId   String?
  fileTemplate     FileTemplate? @relation(fields: [fileTemplateId], references: [id])
  rulePackId       String?
  rulePack         ComplianceRulePack? @relation(fields: [rulePackId], references: [id])
  message          String?
  sentToVendorAt   DateTime?
  approvedAt       DateTime?
  completedAt      DateTime?
  lastDiffFromVersion Int?
  lastDiffToVersion   Int?
  lastDiffSummary     String?
  lastDiffLines       Json? // [{type:'add'|'remove'|'same', text:string}]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  issues ReviewIssue[]

  @@index([ownerId])
  @@index([status])
  @@index([parentDealId])
  @@index([recordType])
  @@index([commercialTypeId])
}

// ── Master data (product catalog) ─────────────────────────────────────────────
// One row per product. `side` splits the two catalogs:
//   SALES       — what we sell; entered by sales (or extracted from a price list),
//                 and picked into sales contracts as line items.
//   PROCUREMENT — what we buy; auto-extracted from a signed procurement agreement,
//                 then editable to correct extraction mistakes.
model MasterProduct {
  id           String  @id @default(cuid())
  // System-generated surrogate key that guarantees catalog integrity. NOT shown
  // in the UI. The human `sku` below is a manufacturer part number and may repeat
  // across (or within) vendors, so it is intentionally NOT unique.
  skuId        String? @unique
  side         String  @default("SALES") // SALES | PROCUREMENT
  name         String
  sku          String? // manufacturer part number — not unique
  manufacturer String? // manufacturer / organization the product is dealt with
  family       String? // product family
  pricingModel String? // LICENSED (per-seat/user) | CONSUMPTION (prepaid credits / usage)
  quantity     Float? // total users / licenses / seats signed for (licensed model)
  creditsPurchased Float? // prepaid credits purchased in advance (consumption model)
  unitPrice    Float?
  currency     String  @default("USD")
  pricingNotes String? // family / tiered pricing detail
  validFrom    DateTime? // term start (procurement) / price-valid-from (sales)
  validUntil   DateTime? // term end (procurement) / price-valid-until (sales)
  status       String  @default("ACTIVE") // ACTIVE | ARCHIVED
  method       String  @default("MANUAL") // MANUAL | AI (provenance of the row)
  sourceDocumentId String? // Document.id the value was extracted from (no FK, mirrors AttributeValue)
  sourceDealId     String? // procurement: the signed Deal it came from (no FK)
  ownerId      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([side])
  @@index([sku])
  @@index([sourceDealId])
}

model ReviewIssue {
  id             String   @id @default(cuid())
  dealId         String
  deal           Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  severity       String   @default("MEDIUM") // LOW | MEDIUM | HIGH
  title          String
  description    String
  page           Int?
  status         String   @default("OPEN") // OPEN | RESOLVED | WAIVED
  raisedBySide   String   @default("ORG") // ORG | VENDOR | SYSTEM
  raisedById     String?
  vendorResponse String?
  resolvedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([dealId, status])
}
